{
    "name": "green-oshima/cakephp-vite-bake",
    "description": "CakePHP Bake command extension for setting up Vite with React/Vue/TypeScript/Tailwind",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "vite",
        "react",
        "vue",
        "typescript",
        "tailwind",
        "bake",
        "frontend"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Green Oshima",
            "email": "oshima@green-inc.example.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0",
        "cakephp/bake": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "cakephp/cakephp-codesniffer": "^5.0"
    },
    "suggest": {
        "passchn/cakephp-vite": "ViteHelper for CakePHP - automatically installed during setup"
    },
    "autoload": {
        "psr-4": {
            "ViteBake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ViteBake\\Test\\": "tests/"
        }
    },
    "scripts": {
        "cs-check": "phpcs --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/",
        "cs-fix": "phpcbf --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/ tests/",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
